<mxfile host="app.diagrams.net">
  <diagram name="Request Flow" id="3">
    <mxGraphModel dx="1200" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1300" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Component Interaction — Request Flow" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="How a user request travels through the system" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="310" y="48" width="340" height="18" as="geometry" />
        </mxCell>

        <!-- Steps (main flow — centered) -->
        <mxCell id="s1" value="User submits health question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="280" height="45" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="FastAPI receives request&#xa;POST /api/v1/chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="280" height="45" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="PII Sanitization&#xa;Redact email, phone, SSN, DOB, MRN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="275" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="Emergency Detection&#xa;Match patterns: heart attack, overdose, etc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="375" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="RAG: Search ChromaDB&#xa;Semantic similarity (top 5 chunks)&#xa;Relevance threshold ≥ 0.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="LLM (Llama 3) generates answer&#xa;Strict citation: [Source + Page + Section]&#xa;No general knowledge allowed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="600" width="280" height="65" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="Verification Layer&#xa;Validate every claim has a citation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="720" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="Jargon Simplifier Agent&#xa;Clinical → Plain Language (preserve citations)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="825" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s9" value="Return response to user&#xa;Simplified answer + citations + source snippets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="930" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s10" value="Log to PostgreSQL + LangSmith&#xa;Store feedback (RLHF → Golden Dataset)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="1035" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- Exit branches -->
        <mxCell id="exit1" value="Emergency:&#xa;Return 911 / 988 guidance&#xa;AI locked from responding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="365" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="exit2" value="No relevant documents:&#xa;Explicit refusal — never guess" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="485" width="250" height="50" as="geometry" />
        </mxCell>

        <!-- Main flow arrows -->
        <mxCell id="a12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
