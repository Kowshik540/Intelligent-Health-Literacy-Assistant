# ===========================================
# Healthcare Assistant - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Command: copy .env.example .env (Windows)
#
# NEVER commit .env to git (it contains secrets)
# This is the same concept as .env in Node.js projects

# Application
APP_NAME=Healthcare Intelligent Health Literacy Assistant
DEBUG=True
API_VERSION=v1

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_db

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# ChromaDB (vector database for embeddings)
CHROMA_PERSIST_DIRECTORY=./chroma_data

# LangSmith (optional - for tracing AI calls)
LANGCHAIN_TRACING_V2=False
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=healthcare-assistant
