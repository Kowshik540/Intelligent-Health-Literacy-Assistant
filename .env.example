# ==========================================================
# Environment configuration.
# Copy this file to ".env" and adjust as needed.
# The app runs with sensible defaults even if you skip most of these.
# ==========================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# Default (no setup required) — a local SQLite file:
DATABASE_URL=sqlite:///./healthcare.db
#
# To use PostgreSQL instead, comment the line above and use:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_db

# --- LLM: Local Ollama (default, no API key, no data leaves your machine) ---
# Install Ollama from https://ollama.com, then run:  ollama pull qwen2:1.5b
USE_OLLAMA=True
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:1.5b

# --- LLM: OpenAI (optional alternative to Ollama) ---
# To use OpenAI instead, set USE_OLLAMA=False and provide a key below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Vector Database (ChromaDB) ---
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Observability (LangSmith — optional) ---
LANGCHAIN_TRACING_V2=False
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=healthcare-assistant
