# Healthcare Assistant — Environment Variables

APP_NAME=Healthcare Intelligent Health Literacy Assistant
DEBUG=True
API_VERSION=v1

HOST=0.0.0.0
PORT=8000

# PostgreSQL (Phase 1)
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_db

# ChromaDB (Phase 1)
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ollama LLM (Phase 2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:1.5b
USE_OLLAMA=True
